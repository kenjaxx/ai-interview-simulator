rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- validation helpers ----------
    // Keep the limits below in step with shared/limits.js ([rules] markers) and saveSession() in
    // src/lib/history.js. Rules can't import code, so role/seniority are only length-checked here:
    // the server enforces the real lists (presets, or a sanitized custom role of up to 60 chars).
    //
    // Data model per user:
    //   sessions/{id}              summary (small): averages, answerCount, ...
    //   sessions/{id}/details/qas  the answers, feedback and sample answers
    //   stats/summary              rolling per-mode totals
    // Sessions saved before the split hold `qas` inside the main document. They can still be read
    // and deleted, but only the new shape can be written.

    function isScore(v) {
      return v is int && v >= 0 && v <= 100;
    }

    function validAverages(a) {
      return a is map
        && a.keys().hasOnly(['content', 'clarity', 'confidence', 'overall'])
        && a.keys().hasAll(['content', 'clarity', 'confidence', 'overall'])
        && isScore(a.content)
        && isScore(a.clarity)
        && isScore(a.confidence)
        && isScore(a.overall);
    }

    function validMetrics(m) {
      return m is map
        && m.keys().hasOnly(['wpm', 'fillerCount', 'responseDelaySec'])
        && m.keys().hasAll(['wpm', 'fillerCount', 'responseDelaySec'])
        && m.wpm is number && m.wpm >= 0 && m.wpm <= 600
        && m.fillerCount is number && m.fillerCount >= 0 && m.fillerCount <= 1000
        && m.responseDelaySec is number && m.responseDelaySec >= 0 && m.responseDelaySec <= 600;
    }

    function validStar(s) {
      return s is map
        && s.keys().hasOnly(['situation', 'task', 'action', 'result'])
        && s.keys().hasAll(['situation', 'task', 'action', 'result'])
        && s.situation is bool
        && s.task is bool
        && s.action is bool
        && s.result is bool;
    }

    function validEvaluation(e) {
      return e is map
        && e.keys().hasOnly(['contentScore', 'clarityScore', 'confidenceScore', 'feedback', 'improvementTip', 'star', 'strongAnswer'])
        && e.keys().hasAll(['contentScore', 'clarityScore', 'confidenceScore', 'feedback', 'improvementTip', 'star', 'strongAnswer'])
        && isScore(e.contentScore)
        && isScore(e.clarityScore)
        && isScore(e.confidenceScore)
        && e.feedback is string && e.feedback.size() <= 1000
        && e.improvementTip is string && e.improvementTip.size() <= 500
        && (e.star == null || validStar(e.star))
        && e.strongAnswer is string && e.strongAnswer.size() <= 1500;
    }

    function validQa(q) {
      return q is map
        && q.keys().hasOnly(['question', 'answer', 'inputMethod', 'metrics', 'evaluation', 'isFollowUp'])
        && q.keys().hasAll(['question', 'answer', 'inputMethod', 'metrics', 'evaluation'])
        && q.question is string && q.question.size() >= 1 && q.question.size() <= 500
        && q.answer is string && q.answer.size() <= 4000
        && q.inputMethod in ['voice', 'text']
        && (!('isFollowUp' in q) || q.isFollowUp is bool)
        && validMetrics(q.metrics)
        && validEvaluation(q.evaluation);
    }

    // Rules have no loops, so each possible index (max 12 answers: 10 questions + 2 follow-ups)
    // is checked explicitly. An index past the end of the list passes automatically.
    function qaOk(qas, i) {
      return qas.size() <= i || validQa(qas[i]);
    }

    function validQas(qas) {
      return qas is list
        && qas.size() >= 1 && qas.size() <= 12
        && qaOk(qas, 0) && qaOk(qas, 1) && qaOk(qas, 2) && qaOk(qas, 3) && qaOk(qas, 4)
        && qaOk(qas, 5) && qaOk(qas, 6) && qaOk(qas, 7) && qaOk(qas, 8) && qaOk(qas, 9)
        && qaOk(qas, 10) && qaOk(qas, 11);
    }

    // The summary document: everything except the answers.
    function validSession(d) {
      return d.keys().hasOnly(['role', 'seniority', 'mode', 'overallSummary', 'averages', 'answerCount', 'createdAt'])
        && d.keys().hasAll(['role', 'seniority', 'mode', 'overallSummary', 'averages', 'answerCount', 'createdAt'])
        && d.role is string && d.role.size() >= 1 && d.role.size() <= 60
        && d.seniority is string && d.seniority.size() >= 1 && d.seniority.size() <= 20
        && d.mode in ['practice', 'full']
        && d.overallSummary is string && d.overallSummary.size() <= 1000
        && validAverages(d.averages)
        && d.answerCount is int && d.answerCount >= 1 && d.answerCount <= 12
        && d.createdAt == request.time; // must be serverTimestamp(), so it can't be forged
    }

    // The details document: only the answers.
    function validDetails(d) {
      return d.keys().hasOnly(['qas'])
        && validQas(d.qas);
    }

    // One mode's running totals. The sums are sums of per-session averages (each 0-100), so they
    // can never exceed 100 * count.
    function validBucket(b) {
      return b is map
        && b.keys().hasOnly(['count', 'content', 'clarity', 'confidence', 'overall', 'best'])
        && b.keys().hasAll(['count', 'content', 'clarity', 'confidence', 'overall', 'best'])
        && b.count is int && b.count >= 0 && b.count <= 1000000
        && b.content is int && b.content >= 0 && b.content <= 100 * b.count
        && b.clarity is int && b.clarity >= 0 && b.clarity <= 100 * b.count
        && b.confidence is int && b.confidence >= 0 && b.confidence <= 100 * b.count
        && b.overall is int && b.overall >= 0 && b.overall <= 100 * b.count
        && isScore(b.best);
    }

    function validStats(d) {
      return d.keys().hasOnly(['full', 'practice', 'updatedAt'])
        && d.keys().hasAll(['full', 'practice', 'updatedAt'])
        && validBucket(d.full)
        && validBucket(d.practice)
        && d.updatedAt == request.time;
    }

    function isOwner(uid) {
  return request.auth != null
    && request.auth.uid == uid
    && request.auth.token.email_verified == true;
}

    // Each user can only touch their own data.
    match /users/{uid}/sessions/{sessionId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSession(request.resource.data);

      match /details/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'qas' && validDetails(request.resource.data);
      }
    }

    match /users/{uid}/stats/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'summary' && validStats(request.resource.data);
    }
  }
}