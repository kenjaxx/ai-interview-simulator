rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only touch their own sessions.
    match /users/{uid}/sessions/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.mode in ['practice', 'full']
        && request.resource.data.qas is list
        && request.resource.data.qas.size() >= 1
        && request.resource.data.qas.size() <= 10;
    }
  }
}